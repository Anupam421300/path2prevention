# ─────────────────────────────────────────────────────
#  Path2Prevention — Environment Variables
#  Copy this file to .env and fill in ALL values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────

# ── MongoDB Atlas ──────────────────────────────────────
# Get from: cloud.mongodb.com → Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/path2prevention?retryWrites=true&w=majority

# ── JWT Auth ───────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_128_char_random_hex_string
JWT_EXPIRES_IN=7d

# ── Environment ───────────────────────────────────────
NODE_ENV=production

# ── CORS ───────────────────────────────────────────────
# Your production domain on Vercel (or custom domain)
ALLOWED_ORIGIN=https://your-app-name.vercel.app

# ── Web Push / VAPID (for browser push notifications) ──
# Generate: node -e "const {generateVAPIDKeys}=require('web-push'); console.log(JSON.stringify(generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@yourdomain.com

# ── Risk Score Thresholds ──────────────────────────────
RISK_THRESHOLD_MEDIUM=25
RISK_THRESHOLD_HIGH=50
RISK_THRESHOLD_VERY_HIGH=75
